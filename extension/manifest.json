{
  "manifest_version": 3,
  "name": "Trancy 字幕浮窗",
  "version": "1.4.0",
  "minimum_chrome_version": "116",
  "description": "优先显示 Trancy 双语字幕，未开启时回退到 YouTube 自带字幕；支持置顶浮窗、字号间距与播放控制。非官方扩展。",
  "permissions": ["storage"],
  "action": {
    "default_title": "Trancy 字幕浮窗",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["reader.js", "content.js"],
    "run_at": "document_idle"
  }]
}
